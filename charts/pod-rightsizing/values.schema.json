{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "readScope": {
          "type": "string",
          "enum": ["cluster", "supportedKinds"]
        },
        "supportedKindsSecretName": {
          "type": "string",
          "minLength": 1
        },
        "supportedKinds": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/builtinSupportedKind"}
        },
        "additionalSupportedKinds": {
          "type": "array",
          "items": {"$ref": "#/definitions/additionalSupportedKind"}
        }
      },
      "required": ["supportedKindsSecretName", "supportedKinds", "additionalSupportedKinds"]
    }
  },
  "required": ["global"],
  "definitions": {
    "builtinSupportedKind": {
      "type": "object",
      "required": ["Version", "Kind", "Alias"],
      "properties": {
        "Group": {"type": "string"},
        "Version": {"type": "string", "minLength": 1},
        "Kind": {"type": "string", "minLength": 1},
        "Alias": {"type": "string", "minLength": 1},
        "Resource": {"type": "string", "minLength": 1},
        "Properties": {
          "type": "array",
          "items": {"type": "string", "enum": ["Native", "Standalone", "Virtual", "Builtin"]}
        }
      }
    },
    "additionalSupportedKind": {
      "type": "object",
      "required": ["Version", "Kind", "Alias"],
      "properties": {
        "Group": {"type": "string"},
        "Version": {"type": "string", "minLength": 1},
        "Kind": {"type": "string", "minLength": 1},
        "Alias": {"type": "string", "minLength": 1},
        "Resource": {"type": "string", "minLength": 1},
        "Properties": {
          "type": "array",
          "items": {"type": "string", "enum": ["Virtual", "Standalone"]}
        }
      }
    }
  }
}
