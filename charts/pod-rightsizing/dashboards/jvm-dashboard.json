            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "sum by (namespace,pod,container,gc) (increase(jvm_gc_collection_seconds_sum{namespace=~\"$namespace\",workload_name=~\"$workload\",pod=~\"$pod\",container=~\"$container\"}[1m])) / 60",
          "legendFormat": "{{pod}} {{container}} {{gc}} collection overhead",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "sum by (namespace,pod,container,gc) (increase(jvm_gc_pause_seconds_sum{namespace=~\"$namespace\",workload_name=~\"$workload\",pod=~\"$pod\",container=~\"$container\"}[1m])) / 60",
          "legendFormat": "{{pod}} {{container}} {{gc}} pause overhead",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "GC Overhead %",
      "type": "timeseries"
