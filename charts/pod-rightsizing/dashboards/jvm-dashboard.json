      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "kube_pod_container_resource_requests{resource=\"memory\",namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",container!=\"\",container!=\"POD\"} and on(namespace,pod,container) max by (namespace,pod,container) (jvm_info{namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",workload_name=~\"$workload\"})",
          "legendFormat": "{{pod}} {{container}} request",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "container_memory_working_set_bytes{namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",container!=\"\",container!=\"POD\"} and on(namespace,pod,container) max by (namespace,pod,container) (jvm_info{namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",workload_name=~\"$workload\"})",
          "legendFormat": "{{pod}} {{container}} container usage",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "(max by (namespace,pod,container) (jvm_memory_used_bytes{area=\"heap\",id!~\".+\",namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",workload_name=~\"$workload\"})) or (sum by (namespace,pod,container) (jvm_memory_used_bytes{area=\"heap\",namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",workload_name=~\"$workload\",id=~\".+\"}))",
          "legendFormat": "{{pod}} {{container}} heap used",
          "range": true,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "(max by (namespace,pod,container) (jvm_memory_used_bytes{area=\"nonheap\",id!~\".+\",namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",workload_name=~\"$workload\"})) or (sum by (namespace,pod,container) (jvm_memory_used_bytes{area=\"nonheap\",namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",workload_name=~\"$workload\",id=~\".+\"}))",
          "legendFormat": "{{pod}} {{container}} non-heap used",
          "range": true,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "clamp_min((container_memory_working_set_bytes{namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",container!=\"\",container!=\"POD\"} and on(namespace,pod,container) max by (namespace,pod,container) (jvm_info{namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",workload_name=~\"$workload\"})) - on(namespace,pod,container) ((max by (namespace,pod,container) (jvm_memory_used_bytes{area=\"heap\",id!~\".+\",namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",workload_name=~\"$workload\"})) or (sum by (namespace,pod,container) (jvm_memory_used_bytes{area=\"heap\",namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",workload_name=~\"$workload\",id=~\".+\"}))) - on(namespace,pod,container) ((max by (namespace,pod,container) (jvm_memory_used_bytes{area=\"nonheap\",id!~\".+\",namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",workload_name=~\"$workload\"})) or (sum by (namespace,pod,container) (jvm_memory_used_bytes{area=\"nonheap\",namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",workload_name=~\"$workload\",id=~\".+\"}))), 0)",
          "legendFormat": "{{pod}} {{container}} estimated native/other",
          "range": true,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "VictoriaMetrics"
          },
          "editorMode": "code",
          "expr": "(max by (namespace,workload_name,container) (kompass_rs_recommendations{namespace=~\"$namespace\",container=~\"$container\",resource_type=\"memory\",resource_source=\"desired\",mode=\"live\"}) and on(namespace,workload_name,container) max by (namespace,workload_name,container) (jvm_info{namespace=~\"$namespace\",pod=~\"$pod\",container=~\"$container\",workload_name=~\"$workload\"})) or (max by (namespace,workload_name,container) (kompass_rs_recommendations{namespace=~\"$namespace\",container=~\"$container\",workload_kind=\"deployment\",resource_type=\"memory\",resource_source=\"desired\",mode=\"live\"}) and on(namespace,workload_name) max by (namespace,workload_name) (label_replace(kube_replicaset_owner{namespace=~\"$namespace\",owner_kind=\"Deployment\"}, \"workload_name\", \"$1\", \"owner_name\", \"(.+)\") and on(namespace,replicaset) label_replace(kube_pod_owner{namespace=~\"$namespace\",pod=~\"$pod\",owner_kind=\"ReplicaSet\"}, \"replicaset\", \"$1\", \"owner_name\", \"(.+)\")))",
          "legendFormat": "{{workload_name}} {{container}} Kompass desired",
          "range": true,
          "refId": "F"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "VictoriaMetrics"
      }
